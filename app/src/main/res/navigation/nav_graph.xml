<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashScreenFragment">

    <fragment
        android:id="@+id/splashScreenFragment"
        android:name="com.example.week13_challenge.ui.views.SplashScreenFragment"
        android:label="fragment_splash_screen"
        tools:layout="@layout/fragment_splash_screen" >
        <action
            android:id="@+id/action_splashScreenFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.week13_challenge.ui.views.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_noteDetailFragment"
            app:destination="@id/noteDetailFragment" />
        <action
            android:id="@+id/action_homeFragment_to_nodeFilterFragment"
            app:destination="@id/nodeFilterFragment" />
    </fragment>
    <fragment
        android:id="@+id/noteDetailFragment"
        android:name="com.example.week13_challenge.ui.views.NoteDetailFragment"
        android:label="Note Detail"
        tools:layout="@layout/fragment_note_detail" >
        <argument
            android:name="note"
            app:argType="com.example.week13_challenge.domain.Note"
            app:nullable="true" />
    </fragment>
    <fragment
        android:id="@+id/nodeFilterFragment"
        android:name="com.example.week13_challenge.ui.views.NodeFilterFragment"
        android:label="Filter Notes"
        tools:layout="@layout/fragment_node_filter" />
</navigation>